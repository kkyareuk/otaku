rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /characters/{characterId} {
      allow read: if resource.data.visibility == "public"
        || (request.auth != null && resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /replies/{replyId} {
      allow create: if request.resource.data.keys().hasOnly([
          "characterId", "personality", "role", "message", "createdAt"
        ])
        && request.resource.data.characterId is string
        && request.resource.data.personality is string
        && request.resource.data.role is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 120;
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/characters/$(resource.data.characterId))
        && get(/databases/$(database)/documents/characters/$(resource.data.characterId)).data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
