rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /firstImpressions/{roomId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      match /responses/{responseId} {
        allow create: if request.auth != null
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 40
          && request.resource.data.keywords is list
          && request.resource.data.keywords.size() <= 8;
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/firstImpressions/$(roomId)).data.ownerId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
